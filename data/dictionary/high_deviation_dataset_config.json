    "target_definition": {
        "target_name": "target_high_deviation",
        "target_type": "binary_classification",
        "positive_class": 1,
        "negative_class": 0,
        "source_column": "205/206\u6bd4",
        "rule": {
            "operator": ">",
            "threshold": 1.15
        },
        "positive_label": "\u9ad8\u5024\u4e56\u96e2",
        "negative_label": "\u975e\u9ad8\u5024\u4e56\u96e2",
        "python_expression": "df['205/206\u6bd4'].astype(float) > 1.15",
        "notes": "H\u5217\u306e\u5024\u304c1.15\u3092\u8d85\u3048\u308b\u5834\u5408\u3092\u9ad8\u5024\u4e56\u96e2\u967d\u6027\u3068\u5b9a\u7fa9\u3059\u308b\u3002G\u5217\u300e\u4e56\u96e2\u533a\u5206\u300f\u306f\u3053\u306etarget\u4f5c\u6210\u306b\u306f\u4f7f\u308f\u306a\u3044\u3002"
    },
